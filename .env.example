# Environment configuration template for Adrastichyperlink Public Tender Engine
# DO NOT put live credentials in this file.

# Authentication & Access Control (Required)
# Master administrative access token for server CLI/automation and login verification
ADMIN_ACCESS_TOKEN=your_admin_access_token_here
# Secret key for HMAC-SHA256 session token signatures (optional; derived from ADMIN_ACCESS_TOKEN if omitted)
SESSION_SECRET=your_cryptographically_random_session_secret_here

# AI Configuration (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL / Supabase Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/adrastichyperlink
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Optional Authorised Procurement Portal Sessions (Server-only; NEVER commit live tokens/cookies)
# FIND_A_TENDER_SESSION_COOKIE=
# CONTRACTS_FINDER_SESSION_COOKIE=
# MULTIQUOTE_SESSION_COOKIE=

