    "start": "tsx scripts/sync_contracts_finder_render.ts && next start",
    "lint": "next lint",
    "test": "tsx scripts/test_unit.ts && tsx scripts/test_contracts_finder.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@supabase/supabase-js": "^2.109.0",
