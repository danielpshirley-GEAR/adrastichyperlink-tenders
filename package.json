{
  "name": "adrastichyperlink-os",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:review": "next build && python3 scripts/assemble_pages.py && python3 scripts/export_review.py",
    "export:review": "python3 scripts/export_review.py",
    "screenshots": "python3 scripts/capture_screenshots.py",
